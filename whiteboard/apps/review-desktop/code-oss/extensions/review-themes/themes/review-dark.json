{
	// Whiteboard Dark: the Whiteboard syntax palette over the stock Dark+ include.
	// Every scope the included theme colors is listed below, so none of its colors reaches the screen;
	// the include only supplies grammar coverage. Roles: keyword, type, function, ink, string, number,
	// operator, comment, inserted, deleted. Regenerated from the Whiteboard System — Syntax themes board.
	"$schema": "vscode://schemas/color-theme",
	"name": "Bugfixer Dark",
	"include": "./../../theme-defaults/themes/dark_plus.json",
	"semanticHighlighting": true,
	"tokenColors": [
		{
			"name": "Whiteboard: comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#778090",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Whiteboard: keyword and storage",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.noexcept",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.typeid",
				"keyword.operator.alignas",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"source.cpp keyword.operator.new",
				"source.cpp keyword.operator.delete",
				"keyword.operator.delete",
				"keyword.other.using",
				"keyword.other.directive.using",
				"keyword.other.operator",
				"entity.name.operator",
				"variable.language",
				"meta.preprocessor",
				"entity.name.function.preprocessor",
				"keyword.operator.or.regexp",
				"keyword.control.anchor.regexp",
				"meta.diff.header",
				"header"
			],
			"settings": {
				"foreground": "#5B7CFF"
			}
		},
		{
			"name": "Whiteboard: type, class, tag, attribute and selector",
			"scope": [
				"entity.name.type",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"entity.name.namespace",
				"entity.other.attribute",
				"entity.name.scope-resolution",
				"entity.name.class",
				"meta.type.cast.expr",
				"meta.type.new.expr",
				"support.constant.math",
				"support.constant.dom",
				"support.constant.json",
				"punctuation.separator.namespace.ruby",
				"storage.type.numeric.go",
				"storage.type.byte.go",
				"storage.type.boolean.go",
				"storage.type.string.go",
				"storage.type.uintptr.go",
				"storage.type.error.go",
				"storage.type.rune.go",
				"storage.type.cs",
				"storage.type.generic.cs",
				"storage.type.modifier.cs",
				"storage.type.variable.cs",
				"storage.type.annotation.java",
				"storage.type.generic.java",
				"storage.type.java",
				"storage.type.object.array.java",
				"storage.type.primitive.array.java",
				"storage.type.primitive.java",
				"storage.type.token.java",
				"storage.type.groovy",
				"storage.type.annotation.groovy",
				"storage.type.parameters.groovy",
				"storage.type.generic.groovy",
				"storage.type.object.array.groovy",
				"storage.type.primitive.array.groovy",
				"storage.type.primitive.groovy",
				"entity.name.tag",
				"entity.name.tag.css",
				"entity.name.tag.less",
				"entity.name.selector",
				"entity.other.attribute-name",
				"entity.other.attribute-name.class.css",
				"source.css entity.other.attribute-name.class",
				"entity.other.attribute-name.id.css",
				"entity.other.attribute-name.parent-selector.css",
				"entity.other.attribute-name.parent.less",
				"source.css entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element.css",
				"source.css.less entity.other.attribute-name.id",
				"entity.other.attribute-name.scss"
			],
			"settings": {
				"foreground": "#6FC3E6"
			}
		},
		{
			"name": "Whiteboard: class name",
			"scope": [
				"entity.name.type.class"
			],
			"settings": {
				"foreground": "#6FC3E6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: function, decorator and section",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"meta.decorator",
				"punctuation.decorator",
				"support.constant.handlebars",
				"source.powershell variable.other.member",
				"entity.name.operator.custom-literal",
				"support.function.git-rebase"
			],
			"settings": {
				"foreground": "#B7C4FF"
			}
		},
		{
			"name": "Whiteboard: heading",
			"scope": [
				"entity.name.section",
				"markup.heading"
			],
			"settings": {
				"foreground": "#B7C4FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: variable, property name and key",
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other",
				"variable.other.property",
				"variable.other.object.property",
				"support.variable",
				"support.variable.property",
				"meta.definition.variable.name",
				"entity.name.variable",
				"constant.other.placeholder",
				"meta.object-literal.key",
				"variable.other.constant",
				"variable.other.enummember",
				"support.type.vendored.property-name",
				"support.type.property-name",
				"support.type.property-name.json",
				"source.css variable",
				"source.coffee.embedded",
				"meta.structure.dictionary.key.python",
				"entity.name.label",
				"constant.other.option",
				"meta.embedded",
				"source.groovy.embedded",
				"string meta.image.inline.markdown",
				"variable.legacy.builtin.python",
				"meta.template.expression",
				"storage.modifier.import.java",
				"variable.language.wildcard.java",
				"storage.modifier.package.java"
			],
			"settings": {
				"foreground": "#EEF0F4"
			}
		},
		{
			"name": "Whiteboard: string, value and regexp",
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"meta.embedded.assembly",
				"string.tag",
				"string.value",
				"string.regexp",
				"constant.regexp",
				"constant.character",
				"string.comment.buffered.block.pug",
				"string.quoted.pug",
				"string.interpolated.pug",
				"string.unquoted.plain.in.yaml",
				"string.unquoted.plain.out.yaml",
				"string.unquoted.block.yaml",
				"string.quoted.single.yaml",
				"string.quoted.double.xml",
				"string.quoted.single.xml",
				"string.unquoted.cdata.xml",
				"string.quoted.double.html",
				"string.quoted.single.html",
				"string.unquoted.html",
				"string.quoted.single.handlebars",
				"string.quoted.double.handlebars",
				"meta.preprocessor.string",
				"markup.inline.raw",
				"support.constant.property-value",
				"support.constant.font-name",
				"support.constant.media-type",
				"support.constant.media",
				"constant.other.color.rgb-value",
				"constant.other.rgb-value",
				"support.constant.color",
				"constant.character.character-class.regexp",
				"constant.other.character-class.set.regexp",
				"constant.other.character-class.regexp",
				"constant.character.set.regexp"
			],
			"settings": {
				"foreground": "#D9A85C"
			}
		},
		{
			"name": "Whiteboard: number, unit and escape",
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
				"keyword.operator.plus.exponent",
				"keyword.operator.minus.exponent",
				"meta.preprocessor.numeric",
				"constant.sha.git-rebase",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#D48FD6"
			}
		},
		{
			"name": "Whiteboard: boolean and language constant",
			"scope": [
				"constant.language"
			],
			"settings": {
				"foreground": "#D48FD6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: operator and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.definition.tag",
				"punctuation.definition.template-expression",
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.section.embedded",
				"punctuation.section.embedded.begin.php",
				"punctuation.section.embedded.end.php",
				"punctuation.definition.quote.begin.markdown",
				"punctuation.definition.list.begin.markdown",
				"markup.changed",
				"punctuation.definition.group.regexp",
				"punctuation.definition.group.assertion.regexp",
				"punctuation.definition.character-class.regexp",
				"punctuation.character.set.begin.regexp",
				"punctuation.character.set.end.regexp",
				"keyword.operator.negation.regexp",
				"support.other.parenthesis.regexp",
				"keyword.operator.quantifier.regexp"
			],
			"settings": {
				"foreground": "#9199A8"
			}
		},
		{
			"name": "Whiteboard: inserted",
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#4ED990"
			}
		},
		{
			"name": "Whiteboard: deleted",
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#F26A55"
			}
		},
		{
			"name": "Whiteboard: invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#F26A55",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Whiteboard: markup bold",
			"scope": [
				"markup.bold",
				"strong"
			],
			"settings": {
				"foreground": "#EEF0F4",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Whiteboard: markup italic",
			"scope": [
				"markup.italic",
				"emphasis"
			],
			"settings": {
				"foreground": "#EEF0F4",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Whiteboard: markup underline",
			"scope": [
				"markup.underline"
			],
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"name": "Whiteboard: markup strikethrough",
			"scope": [
				"markup.strikethrough"
			],
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"name": "Whiteboard: link",
			"scope": [
				"markup.underline.link",
				"string.other.link",
				"constant.other.reference.link"
			],
			"settings": {
				"foreground": "#5B7CFF",
				"fontStyle": "underline"
			}
		}
	],
	"semanticTokenColors": {
		"newOperator": "#5B7CFF",
		"stringLiteral": "#D9A85C",
		"customLiteral": "#B7C4FF",
		"numberLiteral": "#D48FD6"
	},
	"colors": {
		"activityBar.background": "#202426",
		"activityBar.foreground": "#55BDE5",
		"activityBar.inactiveForeground": "#B0B8B8",
		"activityBar.border": "#394143",
		"sideBar.border": "#394143",
		"sideBarTitle.foreground": "#F2F4F4",
		"tab.activeBackground": "#141719",
		"tab.activeForeground": "#F2F4F4",
		"tab.inactiveBackground": "#202426",
		"tab.inactiveForeground": "#B0B8B8",
		"tab.activeBorderTop": "#55BDE5",
		"tab.border": "#394143",
		"editorGroupHeader.tabsBorder": "#394143",
		"titleBar.activeForeground": "#F2F4F4",
		"titleBar.border": "#394143",
		"input.border": "#465052",
		"button.background": "#19B0E8",
		"button.foreground": "#101719",
		"button.hoverBackground": "#55BDE5",
		"editor.background": "#17171C",
		"editorWidget.background": "#202426",
		"panel.border": "#394143",
		"editorWidget.border": "#465052",
		"focusBorder": "#55BDE5",
		"editorGroupHeader.tabsBackground": "#202426",
		"titleBar.activeBackground": "#202426",
		"titleBar.inactiveBackground": "#202426",
		"diffEditor.insertedLineBackground": "#4ED9901F",
		"diffEditor.insertedTextBackground": "#4ED99038",
		"diffEditor.removedLineBackground": "#F26A551F",
		"diffEditor.removedTextBackground": "#F26A5538",
		"widget.shadow": "#00000066",
		"editorHoverWidget.border": "#3A3B3F",
		"editorHoverWidget.background": "#1E2028",
		"sideBar.background": "#202426",
		"diffEditor.diagonalFill": "#39404D40",
